    "limit_state_expr": "C - np.abs(V - 6.0)",
    "correlation": {
      "matrix": []
    }
  },
  "meta": {
    "dim": 2,
    "linearity": "linear",
    "expected_pf": "~5e-2",
    "note": "chi-square distribution"
  }
